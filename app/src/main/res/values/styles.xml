<resources>

    <!-- Textos -->
    <style name="TitleText">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#86B98E</item>
        <item name="android:layout_marginTop">12dp</item>

        <item name="android:fontFamily">@font/poppins_bold</item>

    </style>

    <style name="SubtitleText">
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#808080</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/poppins_regular</item>

    </style>

    <style name="LinkText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#86B98E</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="ForgotPasswordText">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#808080</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_gravity">end</item>
    </style>

    <!-- Inputs -->
    <style name="InputField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">18dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/gray</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>

    <!-- Botones -->
    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:paddingVertical">18dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>

    </style>


    <style name="SocialButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">@color/bg_inputs</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:padding">10dp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <style name="TabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="textAllCaps">false</item>
    </style>


</resources>