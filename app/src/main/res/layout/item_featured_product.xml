<?xml version="1.0" encoding="utf-8"?>
<!-- Usar MaterialCardView es una buena práctica -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    android:layout_marginHorizontal="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Imagen principal del producto destacado -->
        <ImageView
            android:id="@+id/featuredProductImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:src="@drawable/correa_perro"
            android:contentDescription="@string/product_image_desc" />

        <!-- Overlay oscuro para dar contraste al texto -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/gradient_scrim_bottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/guideline_top_scrim" />

        <!-- Guía para controlar la altura del degradado (más flexible) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top_scrim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.5" />



        <!-- Icono de Corazón (como ImageButton para clics) -->
        <ImageButton
            android:id="@+id/featuredFavoriteIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/favorite_background"
            android:padding="10dp"
            android:src="@drawable/ic_favorite"
            app:tint="@color/pink"
            android:contentDescription="@string/add_to_favorites"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Calificación (RatingBar) -->
        <RatingBar
            android:id="@+id/featuredProductRating"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:numStars="5"
            android:progressTint="#FFC107"
            android:isIndicator="true"
            tools:rating="4.5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Título del producto destacado -->
        <TextView
            android:id="@+id/featuredProductName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/featuredFavoriteIcon"
            app:layout_constraintBottom_toTopOf="@id/featuredProductRating"
            tools:text="Correa extensible para perro grande con arnés de seguridad" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
