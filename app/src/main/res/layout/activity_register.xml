<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp">

            <!-- Logo -->
            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@mipmap/logo_huellitas"
                android:layout_gravity="center"
                android:contentDescription="Logo" />

            <!-- Título -->
            <TextView
                android:id="@+id/txtTitle"
                style="@style/TitleText"
                android:text="Ingresar"/>

            <!-- Subtítulo -->
            <TextView
                android:id="@+id/txtSubtitle"
                style="@style/SubtitleText"
                android:text="Por favor ingresa tus credenciales para continuar"/>

            <!-- Botones sociales -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginTop="20dp">

                <Button
                    android:id="@+id/btnFacebook"
                    style="@style/SocialButton"
                    android:text="Facebook"
                    android:drawableLeft="@drawable/icon_facebook"/>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="wrap_content"/>

                <Button
                    android:id="@+id/btnGoogle"
                    style="@style/SocialButton"
                    android:text="Google"
                    android:drawableLeft="@drawable/icon_google"/>
            </LinearLayout>

            <!-- Separador -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E0E0E0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="o"
                    android:textSize="14sp"
                    android:textColor="#808080"
                    android:padding="8dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E0E0E0" />
            </LinearLayout>

            <!-- Input email -->
            <EditText
                android:id="@+id/editTextEmail"
                style="@style/InputField"
                android:layout_marginTop="20dp"
                android:hint="Correo electrónico"
                android:text="fcperalta@ucompensar.edu.co"
                android:inputType="textEmailAddress"/>

            <!-- Input password -->
            <EditText
                android:id="@+id/editTextPassword"
                style="@style/InputField"
                android:layout_marginTop="12dp"
                android:hint="Contraseña"
                android:inputType="textPassword"/>

            <!-- Texto contraseña olvidada -->
            <TextView
                android:id="@+id/txtForgotPassword"
                style="@style/ForgotPasswordText"
                android:text="Contraseña olvidada"/>

            <!-- Botón ingresar -->
            <Button
                android:id="@+id/buttonLogin"
                style="@style/PrimaryButton"
                android:text="Ingresar"/>

            <!-- Texto registro -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿No tienes cuenta?"
                android:textColor="#000000"
                android:textSize="14sp"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/txtRegister"
                style="@style/LinkText"
                android:text="Registrate"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>